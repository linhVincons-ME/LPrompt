# Google Gemini API Key (Tùy chọn nếu cấu hình trực tiếp trên UI)
# Lấy miễn phí tại: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional: URL of the local LPrompt service when the UI is not served by port 8484.
VITE_LPROMPT_API_BASE=http://127.0.0.1:8484

# Local service configuration (loopback-only by default).
LPROMPT_HOST=127.0.0.1
LPROMPT_PORT=8484
LPROMPT_REQUEST_TIMEOUT_MS=30000
# Chỉ khi chủ động bind ngoài loopback:
# LPROMPT_AUTH_TOKEN=replace-with-at-least-24-random-characters
# LPROMPT_ALLOWED_HOSTS=lprompt.internal.example
# LPROMPT_ALLOWED_ORIGINS=https://lprompt.internal.example
