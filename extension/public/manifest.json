{
  "manifest_version": 3,
  "name": "LPrompt for Gemini",
  "description": "Soạn và cấu trúc prompt trong side panel, sau đó chèn thủ công vào Gemini.",
  "version": "3.0.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": ["https://gemini.google.com/*", "http://127.0.0.1:8484/*"],
  "background": { "service_worker": "serviceWorker.js", "type": "module" },
  "action": { "default_title": "Mở LPrompt Side Panel" },
  "side_panel": { "default_path": "extension/sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
