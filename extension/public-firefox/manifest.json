{
  "manifest_version": 3,
  "name": "LPrompt for Gemini",
  "description": "Soạn và cấu trúc prompt trong side panel, sau đó chèn thủ công vào Gemini.",
  "version": "3.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "lprompt@linhvincons.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://gemini.google.com/*", "http://127.0.0.1:8484/*"],
  "background": {
    "scripts": ["serviceWorker.js"]
  },
  "action": {
    "default_title": "Mở LPrompt Side Panel"
  },
  "sidebar_action": {
    "default_panel": "extension/sidepanel.html",
    "default_title": "LPrompt for Gemini"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
