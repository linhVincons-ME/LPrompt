{
  "name": "lprompt",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -p tsconfig.extension.json && vite build --config vite.extension.config.ts",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Install-LPromptService.ps1",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Start-LPromptService.ps1",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Stop-LPromptService.ps1",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Restart-LPromptService.ps1",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Get-LPromptServiceStatus.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File service/windows/Uninstall-LPromptService.ps1",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build && npm run build:extension",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.1.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
